@font-face { font-family:'Pally-Regular';src:url('../fonts/serkon-font-1.ttf') format('truetype');font-weight:400;font-display:swap;font-style:normal;}
@font-face { font-family:'Pally-Medium';src:url('../fonts/serkon-font-2.ttf') format('truetype');font-weight:500;font-display:swap;font-style:normal;}
@font-face { font-family:'Pally-Bold';src:url('../fonts/serkon-font-3.ttf') format('truetype');font-weight:700;font-display:swap;font-style:normal;}

.fonts-loader
    position fixed
    top calc(100% + 1px)
    left 0
    .nunito
        font-family "Nunito", sans-serif
        font-weight 400
    .amatic-sc
        font-family "Amatic SC", sans-serif
        font-weight 700
    .pally
        font-family "Pally-Medium", sans-serif
        font-weight 500
