{
  "name": "serkon-homepage",
  "version": "35.0.0",
  "private": true,
  "description": "Serkon（侯世康）的双语个人网站、互动档案与零成本 Cloudflare 实践。",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://serkon-homepage-cn.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackmac566/serkon-homepage.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "npm run provenance:generate && npm run cost:check && npm run release:record && npm run machine:generate",
    "build": "bash scripts/build-verified.sh",
    "machine:generate": "node scripts/generate-machine-layer.mjs",
    "provenance:generate": "node scripts/generate-provenance.mjs",
    "cost:check": "node scripts/check-zero-cost.mjs",
    "release:record": "node scripts/update-release-history.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "我的个人主页"
}
